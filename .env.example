# Copy to .env for Docker Compose, and export the same values in the shell
# before running Python commands that connect to PostgreSQL.
FRAGMENT_DB_PASSWORD=replace-with-a-local-password

# Optional overrides (defaults shown).
# FRAGMENT_DB_HOST=localhost
# FRAGMENT_DB_PORT=55432
# FRAGMENT_DB_NAME=fragment
# FRAGMENT_DB_USER=fragment

# Optional external HSP reference inputs; these files are not distributed.
# HSP_NORMDATA_WORKBOOK=/path/to/hsp_normdata_thesauri.xlsx
# HSP_METADATA_MAPPING=/path/to/Sources_and_Metadata_data_fields.md
